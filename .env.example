# Canonical site URL (used for SEO, OG tags, and Synapse allowed-origins registration).
NEXT_PUBLIC_SITE_URL=https://www.myumbrellahealth.com

# Synapse app that serves /embed/{clinic_slug} — do not point chat API calls here from the site.
NEXT_PUBLIC_SYNAPSE_APP_URL=https://synapse-hamzaiftikhhar.vercel.app
NEXT_PUBLIC_SYNAPSE_CLINIC_SLUG=umbrella-health

# --- Synapse platform (configure on synapse-hamzaiftikhhar.vercel.app, not this repo) ---
# 1. Vercel env (Production): NEXT_PUBLIC_API_BASE_URL=https://synapse-hamzaiftikhhar.vercel.app/api/v1
# 2. Dashboard → Widget → Allowed origins: https://umbrella-health.vercel.app, https://www.myumbrellahealth.com
# 3. EC2 CORS_ALLOWED_ORIGINS must include https://synapse-hamzaiftikhhar.vercel.app
